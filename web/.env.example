# Copy to .env.local and fill in real values for local development.
# See src/lib/env.ts for validation rules.

# Postgres connection string (PostGIS-enabled). See root docker-compose.yml
# or a native Postgres 16 + PostGIS install.
DATABASE_URL=postgres://localhost:5432/corruptionfix

# 64-character hex (32-byte) key used to encrypt reporter identity fields
# (email/phone) at rest in the vault schema. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional outside production (a warned, insecure dev default is used).
VAULT_ENCRYPTION_KEY=

# 64-character hex (32-byte) key used to HMAC reporter identity fields for
# deduplication/lookup without storing them in plaintext. Same generation
# command as above. Optional outside production.
VAULT_HMAC_KEY=

# 64-character hex (32-byte) key used to sign chain checkpoints. Used by a
# later phase; optional for now.
CHECKPOINT_SIGNING_KEY=

# Shared secret required on the Authorization: Bearer header of /api/jobs/*
# routes, called by the scheduled GitHub Actions workflow. Optional outside
# production.
JOB_SECRET=

# Secret used to sign/derive session tokens. Always required.
SESSION_SECRET=

# Resend API key used to send OTP verification emails. Optional — when unset
# (or outside production), OTP codes are logged to the console instead of
# emailed. See src/lib/mailer.ts.
RESEND_API_KEY=

# From address/name used for OTP emails, e.g. "CorruptionFix <no-reply@corruptionfix.org>".
# Optional; a sane default is used when unset.
EMAIL_FROM=

NODE_ENV=development
